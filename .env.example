# 每日 AI 新闻助手 — 配置模板（复制为 .env 并填入真实值；本文件不含真实密钥）

# ===== LLM（OpenAI 兼容接口）=====
# 你提供的 key 与 api 路径（base_url 指向 /v1 结尾的 OpenAI 兼容端点）
LLM_API_KEY=your-llm-api-key
LLM_BASE_URL=https://your-llm-endpoint/v1
LLM_MODEL=your-model-name

# ===== RSS 源（逗号分隔 URL；留空则用内置默认 AI 新闻源清单）=====
RSS_FEEDS=

# ===== 定时任务（24h）=====
DAILY_RUN_HOUR=8
DAILY_RUN_MINUTE=0

# ===== 沙箱根路径（抓取内容/生成简报落盘目录，相对项目根）=====
SANDBOX_ROOT=backend/data/sandbox
